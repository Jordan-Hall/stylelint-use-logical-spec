  "devDependencies": {
    "eslint": "^10.1.0",
    "postcss-styled-syntax": "^0.7.4",
    "stylelint": "^18.0.0"
  },
  "keywords": [
    "stylelint",
    "stylelint-plugin",
    "css",
    "logical",
    "properties",
    "property",
    "flow",
    "relative",
    "values",
    "value",
    "ltr",
    "rtl",
    "directional",
    "dir",
    "inline",
    "block",
    "start",
    "end",
    "align",
    "border",
    "clear",
    "float",
    "margin",
    "padding",
    "size",
    "text"
  ],
  "dependencies": {
    "postcss-value-parser": "^4.2.0"
  }
}
