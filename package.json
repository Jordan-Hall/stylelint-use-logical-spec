{
	"name": "stylelint-use-logical-spec",
	"version": "6.0.0",
	"description": "Enforce usage of logical properties and values in CSS",
	"license": "CC0-1.0",
	"repository": {
		"type": "git",
		"url": "https://github.com/Jordan-Hall/stylelint-use-logical-spec"
	},
	"homepage": "https://github.com/Jordan-Hall/stylelint-use-logical-spec#readme",
	"bugs": "https://github.com/Jordan-Hall/stylelint-use-logical-spec/issues",
	"type": "module",
	"exports": {
		".": {
			"types": "./index.d.ts",
			"default": "./index.js"
		},
		"./package.json": "./package.json"
	},
	"bin": {
		"stylelint-use-logical-spec": "./bin/migrate.js"
	},
	"main": "./index.js",
	"files": [
		"index.js",
		"index.d.ts",
		"lib",
		"bin"
	],
	"scripts": {
		"lint": "eslint .",
		"typecheck": "tsc -p tsconfig.json",
		"test": "node --test test/*.test.js",
		"package": "publint --strict && attw --pack . --profile esm-only",
		"check": "npm run lint && npm run typecheck && npm test && npm run package",
		"prepublishOnly": "npm run check"
	},
	"engines": {
		"node": ">=22"
	},
	"peerDependencies": {
		"stylelint": "^16.7.0 || ^17.0.0 || ^18.0.0"
	},
	"devDependencies": {
		"@arethetypeswrong/cli": "^0.18.5",
		"eslint": "^10.1.0",
		"postcss-styled-syntax": "^0.7.4",
		"publint": "^0.3.25",
		"stylelint": "^18.0.0",
		"typescript": "^7.0.2"
	},
	"keywords": [
		"stylelint",
		"stylelint-plugin",
		"css",
		"logical",
		"properties",
		"property",
		"flow",
		"relative",
		"values",
		"value",
		"ltr",
		"rtl",
		"directional",
		"dir",
		"inline",
		"block",
		"start",
		"end",
		"align",
		"border",
		"clear",
		"float",
		"margin",
		"padding",
		"size",
		"text"
	],
	"dependencies": {
		"postcss-value-parser": "^4.2.0"
	},
	"types": "./index.d.ts"
}
